{
	"info": {
		"name": "schedules-controller",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "GET /schedules/jobs - 200 response status validation for ROLE_ONC",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var ReqBody= {\r",
							"        userName:pm.environment.get(\"emailONC\"),password:pm.environment.get(\"passwordONC\")\r",
							"    };\r",
							"pm.sendRequest({\r",
							"    url: pm.environment.get(\"authurl\"),\r",
							"    method: \"POST\",\r",
							"    header: {\r",
							"        \"Content-Type\": \"application/json\",\r",
							"        \"API-KEY\": pm.environment.get(\"apiKey\")\r",
							"    },\r",
							"    body: JSON.stringify(ReqBody)\r",
							"}, function (err, response) {\r",
							"   var jsonData = response.json();\r",
							"   pm.environment.set(\"token\",jsonData[pm.environment.get(\"authTokenField\")])\r",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"ROLE_ONC should get 200 response from /schedules/jobs end point and response body should not be empty\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.response).not.eq(null);\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "API-KEY",
						"value": "{{apiKey}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{url}}/rest/schedules/jobs",
					"host": [
						"{{url}}"
					],
					"path": [
						"rest",
						"schedules",
						"jobs"
					]
				},
				"description": "Test to validate that ROLE_ONC gets 200 response from /schedules/jobs end point and the response body is not null"
			},
			"response": []
		},
