{
	"info": {
		"name": "status-controller",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "GET /system-status - valid API Key",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Endpoints that did not require an API Key still work with valid one ,return status 200 and response should not be empty\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.response).not.eq(null);\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "API-Key",
						"type": "text",
						"value": "{{apiKey}}"
					},
					{
						"key": "Content-Type",
						"type": "text",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{url}}/rest/system-status",
					"host": [
						"{{url}}"
					],
					"path": [
						"rest",
						"system-status"
					]
				},
				"description": "API calls that run without API Key still work with valid API Keys"
			},
			"response": []
		},
		{
			"name": "GET /system-status - Invalid API Key",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Endpoints that did not require an API Key still work with invalid one ,return status 200 and response should not be empty\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.response).not.eq(null);\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "API-Key",
						"value": "atest123cg",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{url}}/rest/system-status",
					"host": [
						"{{url}}"
					],
					"path": [
						"rest",
						"system-status"
					]
				},
				"description": "API end points that require no API Key should give valid response for calls with invalid API Key"
			},
			"response": []
		},
		{
			"name": "GET /system-status - without API-Key",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Endpoints that did not require an API Key still work without one ,return status 200 and response should not be empty\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.response).not.eq(null);\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url}}/rest/system-status",
					"host": [
						"{{url}}"
					],
					"path": [
						"rest",
						"system-status"
					]
				}
			},
			"response": []
		},
		{
			"name": "GET /api-docs",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"/v3/api-docs endpoint should return status 200 and api documentation details in response\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(pm.response.text()).to.include(\"tags\");\r",
							"    pm.expect(pm.response.text()).to.include(\"name\");\r",
							"    pm.expect(pm.response.text()).to.include(\"description\");\r",
							"    pm.expect(pm.response.text()).to.include(\"security\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "API-Key",
						"value": "{{apiKey}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{url}}/rest/v3/api-docs",
					"host": [
						"{{url}}"
					],
					"path": [
						"rest",
						"v3",
						"api-docs"
					]
				},
				"description": "verify that API page loads swagger documentation"
			},
			"response": []
		}
	]
}
