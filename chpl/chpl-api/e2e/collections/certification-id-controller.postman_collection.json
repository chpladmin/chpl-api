  "item": [
    {
      "name": "GET /certification-ids/{certificationId} - Returns 200 for ONC user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var ReqBody= {\r",
              "        userName:pm.environment.get(\"emailONC\"),password:pm.environment.get(\"passwordONC\")\r",
              "    };\r",
              "pm.sendRequest({\r",
              "    url: pm.environment.get(\"authurl\"),\r",
              "    method: \"POST\",\r",
              "    header: {\r",
              "        \"Content-Type\": \"application/json\",\r",
              "        \"API-KEY\": pm.environment.get(\"apiKey\")\r",
              "    },\r",
              "    body: JSON.stringify(ReqBody)\r",
              "}, function (err, response) {\r",
              "   var jsonData = response.json();\r",
              "   pm.environment.set(\"token\",jsonData[pm.environment.get(\"authTokenField\")])\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"ONC users should get 200 status and correct response for /certification-ids/{certificationId} end point\", function () {\r",
              "    var actualResponseBody = pm.response.json();\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.expect(actualResponseBody.ehrCertificationId).to.equal(\"0015EUU3FE12AA3\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "API-Key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{url}}/rest/certification-ids/0015EUU3FE12AA3",
          "host": [
            "{{url}}"
          ],
          "path": [
            "rest",
            "certification-ids",
            "0015EUU3FE12AA3"
          ]
        },
        "description": "ONC users should get 200 status and correct response for GET /certification_ids/{certificationId} end point"
      },
      "response": []
    },
