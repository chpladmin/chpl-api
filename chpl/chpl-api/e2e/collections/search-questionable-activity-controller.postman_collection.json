				{
					"name": "GET /questionable-activity/trigger-types - status 401 for ACB users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"expect ACB to get status code 401 on GET questionable activity trigger types request\", function () {\r",
									"    pm.response.to.have.status(401);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "API-Key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{url}}/rest/questionable-activity/trigger-types",
							"host": [
								"{{url}}"
							],
							"path": [
								"rest",
								"questionable-activity",
								"trigger-types"
							]
						},
						"description": "GET /questionable-activity/trigger-types - status 401 for ACB users"
					},
