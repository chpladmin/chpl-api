			"name": "GET /report-data/svaps/svaps-by-criteria-and-certification-status - 200 status and valid response",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"/svaps-by-criteria-and-certification-status should retrieve the data used to generate the SVAP usage by criteria report in response and return 200 status\", function () {\r",
							"    pm.expect(pm.response.text()).to.include(\"svapId\");\r",
							"    pm.expect(pm.response.text()).to.include(\"regulatoryTextCitation\");\r",
							"    pm.expect(pm.response.text()).to.include(\"approvedStandardVersion\");\r",
							"    pm.expect(pm.response.text()).to.include(\"replaced\");\r",
							"    pm.expect(pm.response.text()).to.include(\"criterion\");\r",
							"});"
						],
